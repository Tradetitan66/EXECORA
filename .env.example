# --- Public Stripe checkout (client builds checkout URL via /api/create-checkout) ---
# This public value is no longer required for the new Checkout Session flow, but
# can be kept if you still want a plain Payment Link fallback anywhere.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# --- Public Apps Script web app URL that writes leads to Google Sheets ---
NEXT_PUBLIC_CONTACT_SCRIPT_URL=

# --- Sanity CMS (public-safe; no read token required for public reads) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=p0mpfgmr
NEXT_PUBLIC_SANITY_DATASET=production

# --- Server-only env vars (MUST be added in Vercel project settings, NOT committed) ---
# Stripe secret key (sk_live_.../sk_test_...). Used by api/create-checkout and api/webhook.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). From Stripe Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=

# Public base URL of the site, used for Stripe success/cancel redirects.
# e.g. https://www.execora.work  (or http://localhost:5173 for local preview via the CLI)
FRONTEND_URL=https://www.execora.work

# --- Server-only env vars for the blog draft endpoint (/api/create-blog-draft) ---
# Sanity write token (Editor role) — creates blogPost documents as DRAFTS only.
# From: sanity.io/manage → <project> → API → Tokens.
# MUST be set in Vercel project settings. Do NOT prefix with NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=

# Secret used to authenticate requests to /api/create-blog-draft
# (Authorization: Bearer <BLOG_DRAFT_API_SECRET>). Generate securely, e.g.
# `openssl rand -hex 32`. MUST be set in Vercel project settings.
# Do NOT prefix with NEXT_PUBLIC_.
BLOG_DRAFT_API_SECRET=

# --- Server-only env vars for the daily blog automation endpoint (/api/generate-daily-blog) ---
# OpenAI API key for text and image generation. Do NOT prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# OpenAI text model for article generation. Falls back to gpt-5.4-mini if unset.
OPENAI_TEXT_MODEL=

# OpenAI image model for featured image generation. Falls back to gpt-image-1-mini if unset.
OPENAI_IMAGE_MODEL=

# Secret used to authenticate Vercel Cron GET and manual POST requests to
# /api/generate-daily-blog (Authorization: Bearer <CRON_SECRET>). Generate
# securely, e.g. `openssl rand -hex 32`. MUST be set in Vercel project
# settings. Do NOT prefix with NEXT_PUBLIC_.
CRON_SECRET=

# --- Google Analytics 4 (optional; public-safe) ---
# GA4 Measurement ID (format G-XXXXXXXXXX). Leave empty to disable GA4.
# Add your real ID to your local .env and Vercel project settings.
VITE_GA_MEASUREMENT_ID=

# Set to "true" ONLY to enable GA4 while running Vite locally (npm run dev).
# Analytics is otherwise disabled in local development.
VITE_GA_ENABLE_DEV=
