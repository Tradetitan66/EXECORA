{
  "crons": [
    {
      "path": "/api/daily-blog-0700",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/daily-blog-0800",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "execora.work" }],
      "destination": "https://www.execora.work/$1",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://execora.sanity.studio",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://execora.sanity.studio/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog.html"
    }
  ]
}
